---
# zapz configuration
# The installer copies this to config/default.yml; edit that copy.
# Missing or empty values are skipped, so delete anything you don't want
# zapz to manage.

# Git configuration
git:
  user:
    name: ""   # Leave empty to keep your existing git identity
    email: ""
  editor: "vim"
  default_branch: "main"
  # Any other `git config --global` options
  config:
    core.autocrlf: "input"
    pull.rebase: "true"

# Node.js (installed with nvm)
node:
  versions:
    - "lts/krypton"   # Node.js 24
    - "lts/jod"       # Node.js 22
  default: "lts/krypton"
  global_packages:
    - "pnpm"
    - "typescript"

# Homebrew packages
homebrew:
  taps: []
  formulas:
    - "git"
    - "gh"
    - "jq"
    - "ripgrep"      # Fast search tool
    - "fd"           # Fast find alternative
    - "tree"
    - "wget"
    - "oven-sh/bun/bun"
    - "deno"
  casks:
    - "visual-studio-code"
    - "iterm2"
    - "docker"
    - "1password"

# macOS preferences (omit a key to leave that setting alone)
macos:
  dock:
    autohide: true
    magnification: false
    minimize-to-application: true
  keyboard:
    key_repeat: 2            # Lower is faster
    initial_key_repeat: 15   # Lower is a shorter delay
  finder:
    show_all_extensions: true
    show_hidden_files: true
    show_path_bar: true
    show_status_bar: true
  developer_mode: false      # Enable DevToolsSecurity (asks for your password)

# Scheduled package updates (Homebrew, global npm packages, App Store via mas)
cron:
  update_schedule:
    enabled: true
    frequency: "weekly"   # daily, weekly or monthly (monthly runs on the 1st)
    time: "09:00"         # 24-hour HH:MM
    days: ["Monday"]      # Weekly only; one or more day names
